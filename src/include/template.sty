\providecommand{\zvecL}{\ensuremath{\V{z}_\T{L}}}
\providecommand{\vvec}{\ensuremath{\V{v}}}
\providecommand{\yvec}{\ensuremath{\M{y}}}
\providecommand{\Jvec}{\ensuremath{\V{J}}}

