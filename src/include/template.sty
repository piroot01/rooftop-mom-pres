%
% math
%


% for avoiding \mbox{} everywhere...
\relpenalty=10000
\binoppenalty=10000

% avid singletons
\widowpenalty=10000
\clubpenalty=10000

% basic constants, and math objects
\providecommand{\I}{\ensuremath{\mathrm{i}}} % imaginary unit
\providecommand{\RE}{\ensuremath{\mathrm{Re}}} % real part of...
\providecommand{\IM}{\ensuremath{\mathrm{Im}}} % imaginary part of...
\providecommand{\Quot}[1]{``{#1}"} % quotation
\providecommand{\D}{\,\mathrm{d}} % d for integral
\providecommand{\V}[1]{\vb*{#1}} % vector
\providecommand{\M}[1]{\mathbf{#1}} % matrix
\providecommand{\T}[1]{\vb*{\mathcal{#1}}} % tensor
%\providecommand{\T}[1]{\mathrm{#1}} % upright text (subindex, superindex,..)
\providecommand{\UV}[1]{\V{\hat{#1}}} % unit vector
\providecommand{\NORM}[1]{\left\| #1 \right\|} % norm
\providecommand{\ABS}[1]{\left| #1 \right|} % absolute value
\providecommand{\OP}[1]{{\mathcal{#1}}} % operator
\providecommand{\R}{\mathbb{R}}
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\C}{\mathbb{C}}
\providecommand{\herm}{\mathrm{H}} 
\providecommand{\trans}{\mathrm{T}}
\providecommand{\mySubj}{\mathrm{subj.}}

% smaller version of a math symbol
\providecommand{\smallmathcal}[1]{
    \mathchoice
    {{\scriptstyle\mathcal{#1}}} % \displaystyle
    {{\scriptstyle\mathcal{#1}}} % \textstyle
    {{\scriptscriptstyle\mathcal{#1}}} % \scriptstyle
    {\scalebox{.7}{$\scriptscriptstyle\mathcal{#1}$}} %\scriptscriptstyle
}


% Bessels, Neumann, Hankel functions
\providecommand{\JBSL}[2]{\mathrm{j}_{#1} \left( #2 \right)}  
\providecommand{\YBSL}[2]{\mathrm{y}_{#1} \left( #2 \right)}
\providecommand{\HBSL}[3]{\mathrm{h}_{#1}^{(#2)} \left( #3 \right)}

% spherical waves
\providecommand{\UFCN}[3]{\M{u}_{#1}^{\left( #2 \right)} \left(#3\right)}
\providecommand{\RFCN}[3]{\mathrm{R}_{#1}^{\left( #2 \right)} \left(#3\right)}
\providecommand{\YFCN}[2]{\M{Y}_{#1}\left(#2\right)}
\providecommand{\YFCNs}[2]{\mathrm{Y}_{#1}\left(#2\right)}
\providecommand{\AFCN}[2]{\M{A}_{#1}\left(#2\right)}
\providecommand{\PFCNn}[3]{\tilde{\mathrm{P}}_{#1}^{#2}\left(#3\right)}

% constants (keep them as LaTeX variables)
\providecommand*{\EPS}{\ensuremath{\varepsilon_0}} % permittivity
\providecommand*{\MUE}{\ensuremath{\mu_0}} % permeability
\providecommand*{\SIGMA}{\ensuremath{\sigma}} % conductivity
\providecommand{\ZVAC}{\ensuremath{Z_0}} % impedance of vacuum
\providecommand*{\KZ}{\ensuremath{k_0}} % wave number

